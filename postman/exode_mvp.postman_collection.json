{
  "info": {
    "name": "Exode MVP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login owner",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\":\"owner@example.com\",\"password\":\"password123\"}"},
            "url": "{{base_url}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const payload = json.payload || json;",
                  "pm.environment.set('access_token', payload.access_token);",
                  "pm.environment.set('refresh_token', payload.refresh_token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "Schools",
      "item": [
        {
          "name": "List schools",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/v1/schools"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const payload = json.payload || json;",
                  "if (payload.length) pm.environment.set('school_id', payload[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Public catalog",
          "request": {"method": "GET", "url": "{{base_url}}/api/v1/public/courses?school_id={{school_id}}"}
        },
        {
          "name": "Staff course list",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/v1/courses?school_id={{school_id}}"
          }
        }
      ]
    },
    {
      "name": "Homework",
      "item": [
        {
          "name": "Submit attempt",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\"lesson_id\":\"{{lesson_id}}\",\"answer_text\":\"Demo answer\"}"},
            "url": "{{base_url}}/api/v1/attempts"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Products",
          "request": {"method": "GET", "url": "{{base_url}}/api/v1/products?school_id={{school_id}}"}
        },
        {
          "name": "Checkout",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\"product_id\":\"{{product_id}}\"}"},
            "url": "{{base_url}}/api/v1/checkout/sessions"
          }
        }
      ]
    },
    {
      "name": "Learning",
      "item": [
        {
          "name": "Progress",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/v1/me/courses/{{course_id}}/progress"
          }
        },
        {
          "name": "Lesson player",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/v1/learn/lessons/{{lesson_id}}/player"
          }
        }
      ]
    },
    {
      "name": "Messenger",
      "item": [
        {
          "name": "Chats",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/v1/chats"
          }
        },
        {
          "name": "Send message",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\"body\":\"Salom\"}"},
            "url": "{{base_url}}/api/v1/chats/{{channel_id}}/messages"
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/v1/analytics/dashboard?school_id={{school_id}}"
          }
        }
      ]
    }
  ]
}
